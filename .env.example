# ─────────────────────────────────────────────────────────────
# Throne Clash — переменные окружения
# Скопируйте:  cp .env.example .env   и замените значения.
# .env в .gitignore — НИКОГДА не коммитьте его.
# ─────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Сервер ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# За обратным прокси (nginx, Traefik, облако) — true; по умолчанию true в production
# TRUST_PROXY=true

# ── PostgreSQL (для docker compose значения POSTGRES_* используются и контейнером БД) ──
POSTGRES_USER=throne
POSTGRES_PASSWORD=throne
POSTGRES_DB=throne
DATABASE_URL=postgresql://throne:throne@localhost:5432/throne

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Аутентификация ───────────────────────────────────────────
# Сгенерируйте:  openssl rand -base64 48
# В production сервер НЕ запустится с этим плейсхолдером или ключом короче 32 символов.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Secure-cookie: по умолчанию true в production (нужен HTTPS)
# COOKIE_SECURE=false

# ── CORS / клиент ────────────────────────────────────────────
# Список разрешённых origin через запятую. Должен ТОЧНО совпадать с адресом, с которого открыта игра
# (схема + хост + порт): иначе браузер не сможет обновлять вход и после перезагрузки страницы разлогинит.
CORS_ORIGIN=http://localhost:5173
# По умолчанию клиент ходит на тот же origin (прокси Vite в разработке, nginx в Docker).
# Задавайте, только если API размещён на другом домене:
# VITE_API_URL=https://api.example.com

# ── Лимиты и документация ────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Попытки на один IP: вход и обновление сессии — в минуту, регистрация и гости — в час
AUTH_LOGIN_RATE_MAX=10
AUTH_REGISTER_RATE_MAX=10
AUTH_GUEST_RATE_MAX=20
AUTH_REFRESH_RATE_MAX=60
# Swagger UI на /docs: по умолчанию включён в development и выключен в production
# SWAGGER_ENABLED=true

# ── Владелец и РЕЖИМ БОГА (закрытый режим для владельца) ─────
# Email владельца. Роль OWNER автоматически НЕ выдаётся: зарегистрируйтесь под этим email
# и выполните  pnpm owner:grant  (спросит пароль аккаунта). В Docker:
#   docker compose exec server node dist/owner-grant.js
# Даже с ролью в БД OWNER действует только у аккаунта с этим email.
OWNER_EMAIL=
# По умолчанию: true в development, false в production. Если false — /god и /api/god/* отвечают 404.
GOD_MODE_ENABLED=true
# Хеш argon2 пароля режима бога. Сам пароль в репозитории НЕ хранится.
#   1) pnpm god:hash "ваш длинный пароль"
#   2) вставьте выведенную строку сюда ЦЕЛИКОМ, в ОДИНАРНЫХ кавычках:
#      GOD_MODE_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
GOD_MODE_PASSWORD_HASH=
# Необязательно: секрет TOTP (base32) для второго фактора:  pnpm god:totp
GOD_MODE_TOTP_SECRET=
# Сессия режима бога: минут бездействия до автоматического выхода (скользящее окно)
GOD_SESSION_MINUTES=30
# Изменяющих запросов от одного игрока за 10 секунд; больше — 429 и запись в журнал безопасности
ACTION_RATE_MAX=60

# ── Мир, seed, тесты ─────────────────────────────────────────
# Зерно карты мира (D-09); меняется только до первого запуска
WORLD_SEED=20260101
# pnpm seed создаёт мир, 24 ботов-замка и (вне production) 3 демо-аккаунта demo1..3@example.com.
# Пароль демо-аккаунтов: задайте здесь или он будет сгенерирован и показан один раз.
# В production демо-аккаунты создаются только при SEED_DEMO=true.
# SEED_DEMO=true
# SEED_DEMO_PASSWORD=
# Отдельная БД для тестов: тесты ОЧИЩАЮТ таблицы. В CI используется DATABASE_URL.
# TEST_DATABASE_URL=postgresql://throne:throne@localhost:5432/throne_test
# Кэш таблицы лиги, секунды (0 — без кэша)
LEAGUE_CACHE_SECONDS=5
# Оплата донатов: off — выключена (по умолчанию и в production); test — кристаллы без денег, ТОЛЬКО для разработки.
# Реальный провайдер подключается через интерфейс PaymentProvider (docs/DECISIONS.md, D-62).
PAYMENTS_MODE=off

# Свой домен для docker-compose.prod.yml (без https://)
# DOMAIN=game.example.com
